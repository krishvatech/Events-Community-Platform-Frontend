# API Endpoint
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Saleor Dashboard (optional - set only if you want to override backend URL logic frontend side, though current logic fetches from backend)
# This file is just an example.

# Secure member session rollout (Issue #5)
# Keep false until the Django secure-session endpoints, migration, encryption key,
# and the Cloudflare /_auth/* Worker route are deployed and verified.
VITE_SECURE_AUTH_SESSION_ENABLED=false

# Authentication provider
# Secure-session mode requires Cognito for member/social authentication.
# Keep the legacy backend Google/LinkedIn OAuth fallback only while secure mode is false.
VITE_AUTH_PROVIDER=cognito
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/cognito/callback
